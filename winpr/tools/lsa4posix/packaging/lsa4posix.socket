[Unit]
Description=Socket for the per-user LSA daemon (FreeRDP Remote Credential Guard)
Documentation=https://github.com/FreeRDP/FreeRDP/blob/master/docs/lsa4posix.md

[Socket]
ListenStream=%t/lsa4posix-%U/lsa.sock
SocketMode=0600
# The client refuses a socket directory that is accessible to group or others.
DirectoryMode=0700

[Install]
WantedBy=sockets.target
